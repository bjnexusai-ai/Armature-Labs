{
  "expo": {
    "name": "Armature Labs",
    "slug": "armature-labs-mobile",
    "scheme": "armaturelabs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.armaturelabs.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Armature Labs uses Face ID to unlock the app and protect patient case data."
      }
    },
    "android": {
      "package": "com.armaturelabs.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#EAF7F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Armature Labs uses your camera to capture case photos.",
          "photosPermission": "Armature Labs uses your photo library so you can attach a case photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF7F5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfe48c97-f276-4b7c-85b5-22c15fa32aba"
      }
    },
    "owner": "bjnexusais-team"
  }
}
