# --- Database ---
DOTENV_CONFIG_QUIET=true
DATABASE_URL=postgres://postgres:devpass@localhost:5432/dentallab_dev
PGSSLMODE=disable

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Session ---
WEB_SESSION_TIMEOUT_MINUTES=30

# --- Stripe (Session 8) ---
# BUILD_LOG.md's Session 8 entry claimed these vars were added here at the
# time — confirmed via grep against src/ during the Session 9 integration
# pass that they never actually were. Added now; see PARALLEL_BUILD_PROTOCOL.md
# status board / BUILD_LOG.md Session 9 entry for the correction note.
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CONNECT_ACCOUNT_TYPE=standard
APP_BASE_URL=http://localhost:5173
# STRIPE_PUBLISHABLE_KEY is NOT included here — grepped src/ and it isn't
# actually read anywhere (checkout uses server-created hosted Checkout
# Sessions, no publishable key needed client-side yet). Add it only when an
# embedded Stripe.js flow actually consumes it, to avoid reintroducing the
# same documented-but-unused drift this fix is correcting.
